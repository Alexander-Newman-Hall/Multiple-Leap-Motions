{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "SDK-free C++20 debug engine and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "core-release",
      "inherits": "core-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-core",
      "displayName": "Windows x64 SDK-free MSVC engine and tests",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-legacy",
      "displayName": "Original GUI with locally installed SDK (unverified)",
      "inherits": "windows-core",
      "cacheVariables": { "HANDBRIDGE_BUILD_LEGACY_WINDOWS": "ON", "LEAP_SDK_ROOT": "$env{LEAP_SDK_ROOT}" }
    },
    {
      "name": "control-debug",
      "displayName": "Native Qt controller and SDK-free IPC engine",
      "inherits": "core-debug",
      "cacheVariables": { "HANDBRIDGE_BUILD_CONTROL": "ON" }
    },
    {
      "name": "windows-control",
      "displayName": "Native Qt controller and MSVC x64 IPC engine",
      "inherits": "windows-core",
      "cacheVariables": { "HANDBRIDGE_BUILD_CONTROL": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 native Release portable package (explicit SDK opt-in)",
      "inherits": "windows-control",
      "cacheVariables": { "HANDBRIDGE_WITH_LEAPC": "OFF", "HANDBRIDGE_PACKAGE_WINDOWS": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "macos-intel-core",
      "displayName": "Intel macOS SDK-free C++20 checks (not hardware acceptance)",
      "inherits": "core-debug",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-intel-control",
      "displayName": "Intel macOS QtCore/Network host compatibility checks",
      "inherits": "macos-intel-core",
      "cacheVariables": {
        "HANDBRIDGE_BUILD_CONTROL": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "core-debug", "configurePreset": "core-debug" },
    { "name": "core-release", "configurePreset": "core-release" },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Debug" },
    { "name": "windows-legacy", "configurePreset": "windows-legacy", "configuration": "Debug" },
    { "name": "control-debug", "configurePreset": "control-debug" },
    { "name": "windows-control", "configurePreset": "windows-control", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    {
      "name": "macos-intel-core",
      "configurePreset": "macos-intel-core"
    },
    {
      "name": "macos-intel-control",
      "configurePreset": "macos-intel-control"
    }
  ],
  "testPresets": [
    { "name": "core-debug", "configurePreset": "core-debug", "output": { "outputOnFailure": true } },
    { "name": "core-release", "configurePreset": "core-release", "output": { "outputOnFailure": true } },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "control-debug", "configurePreset": "control-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-control", "configurePreset": "windows-control", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    {
      "name": "macos-intel-core",
      "configurePreset": "macos-intel-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-intel-control",
      "configurePreset": "macos-intel-control",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
