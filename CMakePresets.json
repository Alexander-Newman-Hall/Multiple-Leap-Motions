{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "SDK-free C++20 debug engine and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "core-release",
      "inherits": "core-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-core",
      "displayName": "Windows x64 SDK-free MSVC engine and tests",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-legacy",
      "displayName": "Original GUI with locally installed SDK (unverified)",
      "inherits": "windows-core",
      "cacheVariables": { "HANDBRIDGE_BUILD_LEGACY_WINDOWS": "ON", "LEAP_SDK_ROOT": "$env{LEAP_SDK_ROOT}" }
    }
  ],
  "buildPresets": [
    { "name": "core-debug", "configurePreset": "core-debug" },
    { "name": "core-release", "configurePreset": "core-release" },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Debug" },
    { "name": "windows-legacy", "configurePreset": "windows-legacy", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "core-debug", "configurePreset": "core-debug", "output": { "outputOnFailure": true } },
    { "name": "core-release", "configurePreset": "core-release", "output": { "outputOnFailure": true } },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
